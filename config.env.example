# ===========================================
# WordPress Article Maker - Configuration
# ===========================================

# Email IMAP Configuration
# For Gmail, use App Password: https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_EMAIL=your-email@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# WordPress Configuration
# Create Application Password in: Users → Profile → Application Passwords
WP_URL=https://your-wordpress-site.com
WP_USER=your-wordpress-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# AI Provider Configuration
# Options: anthropic, openai, gemini, ollama
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (GPT)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local - free)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Pipeline Options
CHECK_INTERVAL=300              # Email check interval in seconds
TARGET_LANG=en                  # Target language for articles
MAX_EMAILS_PER_CYCLE=5          # Max emails to process per cycle
AUTO_PUBLISH=false              # Auto-publish without review
FILTER_SENDER=                  # Only process emails from this sender (optional)
